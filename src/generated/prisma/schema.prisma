generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(126)
  passwordHash String   @map("password_hash") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  projects VideoProject[]

  @@map("users")
}

model VideoProject {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  title                String   @db.VarChar(255)
  storyTopic           String?  @map("story_topic") @db.Text
  characterDescription String?  @map("character_description") @db.Text
  script               String?  @db.Text
  contentTone          String?  @map("content_tone") @db.VarChar(100)
  videoGenre           String?  @map("video_genre") @db.VarChar(100)
  numberOfScenes       Int?     @map("number_of_scenes")
  status               String?  @db.VarChar(20)
  videoConfig          Json?    @map("video_config")
  imageConfig          Json?    @map("image_config")
  audioConfig          Json?    @map("audio_config")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  generations VideoGeneration[]

  @@index([userId])
  @@map("video_projects")
}

model VideoGeneration {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  generationNo    Int      @map("generation_no")
  aiModel         String?  @map("ai_model") @db.VarChar(50)
  resolution      String?  @db.VarChar(20)
  aspectRatio     String?  @map("aspect_ratio") @db.VarChar(10)
  voiceSettings   Json?    @map("voice_settings")
  status          String?  @db.VarChar(20)
  outputUrl       String?  @map("output_url") @db.Text
  thumbnailUrl    String?  @map("thumbnail_url") @db.Text
  durationSeconds Int?     @map("duration_seconds")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes  VideoScene[]

  @@unique([projectId, generationNo])
  @@index([projectId])
  @@map("video_generations")
}

model VideoScene {
  id           String  @id @default(uuid()) @db.Uuid
  generationId String  @map("generation_id") @db.Uuid
  sceneOrder   Int     @map("scene_order")
  promptText   String? @map("prompt_text") @db.Text
  imageUrl     String? @map("image_url") @db.Text
  audioUrl     String? @map("audio_url") @db.Text

  generation VideoGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@unique([generationId, sceneOrder])
  @@index([generationId])
  @@map("video_scenes")
}
