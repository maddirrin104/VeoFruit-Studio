# PostgreSQL connection string for Prisma
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/veofruit_studio?schema=public"

# Runway API key (preferred)
RUNWAYML_API_SECRET="your_runway_api_secret"

# Legacy fallback key name supported by code (optional if RUNWAYML_API_SECRET is set)
RUNWAY_API_KEY=""

# Google Veo/Gemini API key (required when using Veo3 generation)
GOOGLE_API_KEY="your_google_api_key"

# Runtime mode (optional for local dev)
# NODE_ENV="development"
