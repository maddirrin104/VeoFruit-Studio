{
  "name": "veofruit-studio",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev --hostname localhost --port 3200",
    "prebuild": "node scripts/prisma-prebuild.js",
    "build": "prisma generate && next build",
    "postbuild": "node scripts/prisma-postbuild.js",
    "start": "next start",
    "lint": "eslint",
    "desktop:dev": "electron .",
    "desktop:build": "npm run build && node scripts/desktop-build.js",
    "desktop:dist": "npm run desktop:build"
  },
  "dependencies": {
    "@google/genai": "^1.46.0",
    "@prisma/client": "^6.19.2",
    "@runwayml/sdk": "^3.16.0",
    "axios": "^1.13.6",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.577.0",
    "next": "16.1.7",
    "pg": "^8.20.0",
    "postcss": "^8.5.8",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "prisma": "^6.19.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.veofruit.studio",
    "productName": "VeoFruit Studio",
    "icon": "public/app-icon.png",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      ".next/**/*",
      "src/generated/prisma/**/*",
      "public/**/*",
      "prisma/**/*",
      "node_modules/**/*",
      "package.json",
      "next.config.mjs",
      "prisma.config.ts",
      "!.next/dev/**",
      "!.next/cache/**",
      "!.next/types/**",
      "!public/uploads/**",
      "!public/generated-audio/**",
      "!**/*.map"
    ],
    "extraResources": [
      { "from": "public/app-icon.png", "to": "app-icon.png" }
    ],
    "asarUnpack": [
      "node_modules/@prisma/**/*",
      "node_modules/ffmpeg-static/**/*",
      "src/generated/prisma/**/*"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "public/app-icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VeoFruit Studio"
    }
  },
  "overrides": {
    "effect": "^3.20.0"
  }
}
