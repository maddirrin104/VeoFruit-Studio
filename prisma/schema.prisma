generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"
  engineType = "wasm"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  fullName     String        @map("full_name")
  passwordHash String        @map("password_hash")
  createdAt    DateTime      @default(now()) @map("created_at")

  projects     VideoProject[]

  @@map("users")
}

model VideoProject {
  id             String            @id @default(uuid())
  userId         String            @map("user_id")
  title          String
  storyTopic     String?           @map("story_topic")
  characterDescription String?      @map("character_description")
  script         String?
  contentTone    String?           @map("content_tone")
  videoGenre     String?           @map("video_genre")
  numberOfScenes Int?              @map("number_of_scenes")
  status         String?
  videoConfig    Json?             @map("video_config")
  imageConfig    Json?             @map("image_config")
  audioConfig    Json?             @map("audio_config")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at")

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  generations    VideoGeneration[]

  @@index([userId])
  @@map("video_projects")
}

model VideoGeneration {
  id              String        @id @default(uuid())
  projectId       String        @map("project_id")
  generationNo    Int           @map("generation_no")
  aiModel         String?       @map("ai_model")
  resolution      String?
  aspectRatio     String?       @map("aspect_ratio")
  voiceSettings   Json?         @map("voice_settings")
  status          String?
  outputUrl       String?       @map("output_url")
  thumbnailUrl    String?       @map("thumbnail_url")
  durationSeconds Int?          @map("duration_seconds")
  createdAt       DateTime      @default(now()) @map("created_at")

  project         VideoProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes          VideoScene[]

  @@index([projectId])
  @@unique([projectId, generationNo])
  @@map("video_generations")
}

model VideoScene {
  id           String          @id @default(uuid())
  generationId String          @map("generation_id")
  sceneOrder   Int             @map("scene_order")
  promptText   String?         @map("prompt_text")
  imageUrl     String?         @map("image_url")
  audioUrl     String?         @map("audio_url")

  generation   VideoGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@index([generationId])
  @@unique([generationId, sceneOrder])
  @@map("video_scenes")
}